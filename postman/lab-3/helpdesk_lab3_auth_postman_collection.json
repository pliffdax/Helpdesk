{
  "info": {
    "_postman_id": "f3c3d4a8-6e65-4a7a-9177-6d87966bf1f2",
    "name": "Helpdesk Lab 3 Auth API",
    "description": "Postman collection for validating Lab 3 authentication routes in the Helpdesk API. Covers registration, login, token-protected requests, profile update, password change, and logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register - success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `lab3.user+${Date.now()}@example.com`;",
                  "pm.environment.set('userEmail', email);",
                  "pm.environment.set('updatedUserEmail', `lab3.updated+${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Register response contains token and user', function () {",
                  "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.user.email).to.eql(pm.environment.get('userEmail'));",
                  "});",
                  "pm.environment.set('accessToken', json.data.accessToken);",
                  "pm.environment.set('userId', String(json.data.user.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lab 3 User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"passwordConfirmation\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "POST /api/auth/register - validation error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Validation error message is returned', function () {",
                  "  pm.expect(json.message).to.eql('password confirmation does not match');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Broken User\",\n  \"email\": \"broken+{{$timestamp}}@example.com\",\n  \"password\": \"{{userPassword}}\",\n  \"passwordConfirmation\": \"mismatch123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
